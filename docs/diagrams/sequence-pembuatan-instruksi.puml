@startuml
!theme plain
autonumber

actor "Petugas Klinik" as Admin
participant "Web Admin" as Web
participant "Laravel API" as API
database "MySQL (dsh_db)" as DB
participant "Outbox Dispatcher" as Outbox
participant "Temporal Server" as TempServer
participant "Temporal Worker" as Worker

Admin -> Web : Pilih Pasien MHLS, Isi Nama Aktivitas, Tanggal, Jam Pengingat
Web -> API : POST /api/admin/activity-plans
activate API

API -> API : Hitung jadwal per hari (daily / custom_days)
API -> DB : BEGIN TRANSACTION
API -> DB : INSERT INTO activity_plans
API -> DB : INSERT INTO activity_schedules (per tanggal)
API -> DB : INSERT INTO outbox_events (ActivityPlanCreated, status: 'pending')
API -> DB : COMMIT TRANSACTION
API --> Web : 201 Created
deactivate API

== Asynchronous Dispatch ke Temporal ==
Outbox -> DB : SELECT * FROM outbox_events WHERE status = 'pending'
DB --> Outbox : Return Event 'ActivityPlanCreated'
Outbox -> TempServer : StartWorkflowExecution\n(WorkflowID: activity-plan-{id}, TaskQueue: activity-plan-queue)
TempServer --> Outbox : Workflow Execution Started (RunID)
Outbox -> DB : INSERT INTO workflow_references (status: 'running')
Outbox -> DB : UPDATE outbox_events SET status = 'published'

TempServer -> Worker : Dispatch Task to Worker
Worker -> Worker : Start ActivityPlanWorkflow
Worker -> TempServer : Start Durable Timer (Waktu Pengingat Jadwal 1)
@enduml
